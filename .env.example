# Public contact address displayed on the site (contact page, footer, forms fallback)
NEXT_PUBLIC_CONTACT_EMAIL=info@ippscc.org

# Canonical production URL used for SEO metadata, sitemap and Open Graph tags
NEXT_PUBLIC_SITE_URL=https://ippscc.org

# Optional: a form-handling endpoint (e.g. Formspree "https://formspree.io/f/xxxxxx").
# When set, the Join and Contact forms POST to this endpoint.
# When empty, forms open the visitor's email client with a pre-filled message instead.
NEXT_PUBLIC_FORM_ENDPOINT=
