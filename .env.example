# Public contact address displayed on the site (contact page, footer, forms fallback)
NEXT_PUBLIC_CONTACT_EMAIL=info@ippscc.org

# Canonical production URL used for SEO metadata, sitemap and Open Graph tags
NEXT_PUBLIC_SITE_URL=https://ippscc.org

# Optional: a form-handling endpoint (e.g. Formspree "https://formspree.io/f/xxxxxx").
# When set, the Contact form POSTs here; otherwise it falls back to pre-filled email.
NEXT_PUBLIC_FORM_ENDPOINT=

# ── Member Portal & Admin backend ──────────────────────────────────
# Secret for signing portal session cookies. REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Supabase (persistent production backend). When BOTH are set, the portal,
# applications and admin use Postgres. When empty, the site runs in
# demonstration mode with temporary in-memory data.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
